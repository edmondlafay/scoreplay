# =============================================================================
# Scoreplay API — environment variables
# Copy to .env and fill in values. Never commit .env to source control.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Option A: full DSN (takes precedence over individual vars below)
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Option B: individual vars
DB_HOST=localhost
DB_PORT=5432
DB_USER=scoreplay
DB_PASSWORD=scoreplay
DB_NAME=scoreplay
DB_SSL_MODE=disable        # use "require" or "verify-full" in production

# Connection pool — tune per deployment size
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# --- Server -----------------------------------------------------------------
PORT=8080
BASE_URL=http://localhost:8080   # public URL prefix used to build file_url fields
UPLOAD_DIR=./uploads             # local directory for uploaded files

# --- Observability ----------------------------------------------------------
# Tracing: leave empty to disable (zero overhead noop exporter)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318   # Jaeger / Grafana Tempo / etc.

# Fraction of requests to trace: 1.0 = 100% (dev default), 0.1 = 10% (prod typical)
TRACE_SAMPLE_RATE=1.0
